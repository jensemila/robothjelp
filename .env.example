# Kopier til .env.local og fyll inn. ALDRI commit ekte nøkler.

# Anthropic Messages API (bedriftskontoen alle kall går fra)
ANTHROPIC_API_KEY=

# Database (SQLite via Prisma i MVP)
DATABASE_URL="file:./dev.db"

# Vipps (settes opp i betalingsbolken)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# BTCPay Server (Lightning + on-chain). Ekstern instans; nøkler settes i
# /etc/robothjelp/env på serveren, aldri her. Webhook må peke på
# <SITE_URL>/api/webhooks/btcpay og abonnere på InvoiceSettled.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# Privacy Pass (blind RSA). Generer med: npm run gen-pp-keys
PP_PRIVATE_KEY=
PP_PUBLIC_KEY=
